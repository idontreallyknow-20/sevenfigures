# Copy to .env.local and fill in what you have. Everything is optional:
# with nothing set, the app runs in demo mode (seed watchlist, simulated prices, saving off).

# Supabase (supabase.com > your project > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub (finnhub.io, free tier): quotes, company profile and key metrics. Server-side only.
FINNHUB_KEY=

# Alpaca Market Data (alpaca.markets, free tier): historical bars for charts. Server-side only.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Any random string (e.g. openssl rand -hex 16). Required for the daily /api/cron snapshot.
CRON_SECRET=

# Public URL of the deployment, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://myportfolio-pi-sandy-73.vercel.app
