# Supabase — get from supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Finnhub (free account at finnhub.io) — powers quotes, company profile and key
# metrics. Server-side only; never exposed to the client.
FINNHUB_KEY=your-finnhub-key

# Alpaca Market Data (create a free account at alpaca.markets, use paper/data account)
# Used for historical price bars (charts/sparklines). Prices ~15 min delayed on free tier.
ALPACA_API_KEY=your-alpaca-key-id
ALPACA_API_SECRET=your-alpaca-secret
ALPACA_PAPER=true

# Vercel Cron — set this to any random string you generate (e.g. openssl rand -hex 16)
# Used to authenticate the /api/cron endpoint so only Vercel can call it
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
